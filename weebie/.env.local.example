# Google Cloud Console > APIs & Services > Credentials
# Client ID already supplied for Google Drive Picker
NEXT_PUBLIC_GOOGLE_CLIENT_ID=693322564638-k21o1t3fao08pafdr4t4khudrnu6ivrd.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=
# Google Cloud project number (not project ID)
