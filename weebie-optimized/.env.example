# Server-only Google Drive authorization. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback
DRIVE_TOKEN_ENCRYPTION_KEY=

# Use Application Default Credentials, or provide the service account JSON as a secret.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_CREDENTIALS_JSON=

# Optional explicit Drive HLS preparation runtime; production requires durable private storage.
WEEBIE_MEDIA_DIR=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
